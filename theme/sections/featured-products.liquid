<section class="featured-products" style="background-color: {{ section.settings.background_color }};">
  <div class="container">
    {% if section.settings.show_heading %}
      <h2 class="featured-products__heading" style="color: {{ section.settings.heading_color }};">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.show_description %}
      <p class="featured-products__description" style="color: {{ section.settings.description_color }};">
        {{ section.settings.description }}
      </p>
    {% endif %}

    <div class="products-grid">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: section.settings.product_count %}
          <div class="product-card">
            <div class="product-image">
              <a href="{{ product.url }}">
                {% if product.featured_image %}
                  <img 
                    src="{{ product.featured_image | image_url: width: 300 }}" 
                    alt="{{ product.title }}"
                    loading="lazy"
                  >
                {% endif %}
              </a>
            </div>
            <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <p class="price">{{ product.price | money }}</p>
            <a href="{{ product.url }}" class="btn btn-secondary">View Details</a>
          </div>
        {% endfor %}
      {% else %}
        <p>Please select a collection</p>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .featured-products {
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_right }}px {{ section.settings.padding_bottom }}px {{ section.settings.padding_left }}px;
    margin: {{ section.settings.margin_top }}px {{ section.settings.margin_right }}px {{ section.settings.margin_bottom }}px {{ section.settings.margin_left }}px;
    transition: background-color 0.3s ease;
  }

  .featured-products__heading {
    text-align: center;
    font-size: {{ section.settings.heading_size }}px;
    margin-bottom: 1rem;
    font-weight: bold;
  }

  .featured-products__description {
    text-align: center;
    font-size: {{ section.settings.description_size }}px;
    margin-bottom: 2rem;
  }
</style>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F8F9FA"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding right",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding left",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Margin top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_right",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Margin right",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Margin bottom",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_left",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Margin left",
      "default": 0
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 28
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": false
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Check out our best-selling products"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 16
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_count",
      "min": 3,
      "max": 12,
      "step": 1,
      "label": "Number of products",
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Featured Products",
      "settings": {
        "background_color": "#F8F9FA"
      }
    }
  ]
}
{% endschema %}
